# Copie este arquivo para .env e preencha. NUNCA commite o .env.
# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentineltrade
DB_USER=sentinel
DB_PASSWORD=defina_uma_senha_local

# Backend
SERVER_PORT=8080

# Reservado para quando o JWT for implementado
# JWT_SECRET=

# BFF (Backend For Frontend)
BFF_PORT=3000
BACKEND_URL=http://localhost:8080
# Chave compartilhada BFF <-> backend (cabecalho X-Bff-Key). Use um valor longo e aleatorio.
BFF_INTERNAL_KEY=troque_por_uma_chave_longa
# Origens do frontend liberadas no CORS (separadas por virgula)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# true somente com HTTPS (producao)
COOKIE_SECURE=false
